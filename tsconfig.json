{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@HM/users/*": ["src/users/*"],
            "@HM/*": ["src/generic/*"],
            "@HM/interface": ["src/generic/interface/*"],
            "@HM/middleware": ["src/generic/middleware/*"],
            "@HM/utils": ["src/generic/utils/*"],
            "@HM/prisma": ["src/database/connection.ts"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", ".prisma", "dist", "build"]
}
