{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022"],
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@HM/*": ["*"],
            "@HM/app/*": ["app/*"],
            "@HM/users/*": ["src/users/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", ".prisma", "dist", "build"]
}
